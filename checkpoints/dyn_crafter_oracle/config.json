{
  "data": {
    "root": "data/crafter",
    "val_fraction": 0.05
  },
  "model": {
    "image_size": 64,
    "patch": 8,
    "dim": 384,
    "enc_depth": 6,
    "enc_heads": 6,
    "pred_depth": 6,
    "pred_heads": 6,
    "num_actions": 17,
    "max_context": 16
  },
  "train": {
    "batch_size": 64,
    "lr": 0.0003,
    "weight_decay": 0.05,
    "steps": 30000,
    "warmup": 1000,
    "grad_clip": 1.0,
    "log_every": 100,
    "eval_every": 2000,
    "eval_batches": 20,
    "ckpt_every_min": 5.0,
    "num_workers": 8,
    "amp": "auto",
    "compile": false,
    "seed": 0,
    "out_dir": "checkpoints/dyn_crafter_oracle",
    "tau_start": 0.996,
    "tau_end": 1.0,
    "loss_type": "l1",
    "vicreg_var_weight": 0.02,
    "vicreg_cov_weight": 0.0,
    "sigreg_weight": 0.05,
    "train_decoder": true,
    "decoder_lr": 0.0003
  }
}