{
  "data": {
    "root": "data/crafter",
    "val_fraction": 0.05,
    "collapse_blocked": false
  },
  "model": {
    "image_size": 64,
    "patch": 8,
    "context": 2,
    "dim": 384,
    "enc_depth": 6,
    "dec_depth": 6,
    "heads": 6,
    "num_codes": 8,
    "code_dim": 32
  },
  "train": {
    "batch_size": 128,
    "lr": 0.0003,
    "weight_decay": 0.05,
    "steps": 30000,
    "warmup": 1000,
    "grad_clip": 1.0,
    "log_every": 100,
    "eval_every": 2000,
    "eval_batches": 30,
    "ckpt_every_min": 5.0,
    "num_workers": 8,
    "amp": "auto",
    "compile": true,
    "seed": 0,
    "out_dir": "checkpoints/lam_crafter"
  }
}