{
  "data": {
    "root": "data/toy",
    "val_fraction": 0.05,
    "collapse_blocked": true
  },
  "model": {
    "image_size": 64,
    "patch": 8,
    "context": 2,
    "dim": 128,
    "enc_depth": 3,
    "dec_depth": 3,
    "heads": 4,
    "num_codes": 8,
    "code_dim": 16
  },
  "train": {
    "batch_size": 32,
    "lr": 0.0005,
    "weight_decay": 0.05,
    "steps": 2000,
    "warmup": 200,
    "grad_clip": 1.0,
    "log_every": 50,
    "eval_every": 500,
    "eval_batches": 10,
    "ckpt_every_min": 5.0,
    "num_workers": 2,
    "amp": "auto",
    "compile": false,
    "seed": 0,
    "out_dir": "checkpoints/lam_toy"
  }
}